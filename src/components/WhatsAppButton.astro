---
import { MessageCircle } from '@lucide/astro';
import { SITE } from '@/data/site';
---
<a href={SITE.whatsapp()} target="_blank" rel="noopener noreferrer" aria-label="Contactar a Richard por WhatsApp" class="fixed bottom-5 right-5 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-[0_12px_35px_rgba(1,20,53,.28)] transition hover:-translate-y-1 hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#25D366] sm:bottom-7 sm:right-7">
  <MessageCircle size={30} stroke-width={2.2} aria-hidden="true" />
</a>
